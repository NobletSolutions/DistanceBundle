{
    "name": "ns/distance-bundle",
    "type": "symfony-bundle",
    "description": "A way to handle postal code distance calculations",
    "license": "MIT",
    "minimum-stability": "stable",
    "authors": [
        {
            "name": "Nathanael David Noblet",
            "email": "nathanael@noblet.ca"
        }
    ],
    "require": {
        "php": ">=7.4",
        "ext-simplexml": "*",
        "ext-zip": "*",
        "doctrine/dbal": "^3.7 || ^4.0",
        "doctrine/doctrine-bundle": "^2.7 || ^3.0",
        "doctrine/orm": "^2.14 || ^3.0",
        "symfony/console": "^5.4 || ^6.0 || ^7.0 || ^8.0",
        "symfony/framework-bundle": "^5.4 || ^6.0 || ^7.0 || ^8.0",
        "symfony/http-client": "^5.4 || ^6.0 || ^7.0 || ^8.0",
        "symfony/yaml": "^5.4 || ^6.0 || ^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": { "NS\\DistanceBundle\\": "src" }
    },
    "autoload-dev": {
        "psr-4": { "NS\\DistanceBundle\\Tests\\": "Tests" }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "liip/rmt": "1.*"
    }
}
