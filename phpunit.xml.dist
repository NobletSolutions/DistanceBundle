<?xml version="1.0" encoding="UTF-8"?>

<phpunit
    backupGlobals               = "false"
    colors                      = "true"
    cacheResult                 = "false"
    bootstrap                   = "vendor/autoload.php">

    <testsuites>
        <testsuite name="Distance Bundle Tests">
            <directory>Tests</directory>
        </testsuite>
    </testsuites>

    <php>
        <ini name="memory_limit" value="256M" />
    </php>

    <coverage>
        <include>
            <directory>src</directory>
        </include>
    </coverage>
</phpunit>
